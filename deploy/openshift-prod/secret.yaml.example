# Example only — create real Secrets out-of-band (do not commit credentials).
#
# This file is documentation. It is NOT valid Kubernetes YAML and must NOT be
# applied with kubectl/oc apply. Use the oc create secret commands below instead.
#
# MP+ prod (prod-mpp-spoke-aws-us-east-1 / mpp-e1-prod) uses Snowflake prod only.
# Connection names live in deploy/openshift-prod/deployment.yaml.
#
# Each connection uses two Secrets:
#   1. *-config — loaded via envFrom; holds SNOWFLAKE_CONN_<NAME>_* literals
#      (including PRIVATE_KEY_FILE path, not the key material)
#   2. *-key — mounted as a volume at /etc/finops/snowflake/<connection>/
#      with a private_key file (never loaded into the process environment)
#
# Prod connection (default on this cluster):
#
#   oc create secret generic finops-backend-snowflake-prod-config \
#     --from-literal=SNOWFLAKE_CONN_PROD_ACCOUNT=gdadclc-rhprod \
#     --from-literal=SNOWFLAKE_CONN_PROD_USER=dataverse_finopstoolsfinopsteam_prod_appuser \
#     --from-literal=SNOWFLAKE_CONN_PROD_WAREHOUSE=DEFAULT \
#     --from-literal=SNOWFLAKE_CONN_PROD_ROLE=DATAVERSE_FINOPSTOOLSFINOPSTEAM_ROLE \
#     --from-literal=SNOWFLAKE_CONN_PROD_DATABASE=HCMFINOPSSOURCE_DB \
#     --from-literal=SNOWFLAKE_CONN_PROD_SCHEMA=MARTS \
#     --from-literal=SNOWFLAKE_CONN_PROD_PRIVATE_KEY_FILE=/etc/finops/snowflake/prod/private_key \
#     -n finops-team--finops-tools-backend
#
#   oc create secret generic finops-backend-snowflake-prod-key \
#     --from-file=private_key=$HOME/.ssh/dataverse-finopstoolsfinopsteam-prod-appuser.p8 \
#     -n finops-team--finops-tools-backend
#
# To update an existing Secret, append --dry-run=client -o yaml | oc apply -f -
# to the command above. Restart the Deployment after changing credentials:
#
#   make openshift-restart OPENSHIFT_ENV=prod
