# Example only — create the real Secret out-of-band (do not commit credentials).
#
# Key-pair service account (recommended for OpenShift):
#
#   oc create secret generic finops-backend-snowflake \
#     --from-literal=SNOWFLAKE_ACCOUNT=example-account \
#     --from-literal=SNOWFLAKE_USER=example-user \
#     --from-file=SNOWFLAKE_PRIVATE_KEY=./rsa_key.p8 \
#     --from-literal=SNOWFLAKE_WAREHOUSE=EXAMPLE_WH \
#     --from-literal=SNOWFLAKE_ROLE=EXAMPLE_ROLE \
#     --from-literal=SNOWFLAKE_DATABASE=EXAMPLE_DB \
#     --from-literal=SNOWFLAKE_SCHEMA=EXAMPLE_SCHEMA \
#     -n finops-team--finops-tools-backend
#
# OAuth token (alternative):
#
#   oc create secret generic finops-backend-snowflake \
#     --from-literal=SNOWFLAKE_ACCOUNT=example-account \
#     --from-literal=SNOWFLAKE_USER=example-user \
#     --from-literal=SNOWFLAKE_TOKEN=example-token \
#     --from-literal=SNOWFLAKE_WAREHOUSE=EXAMPLE_WH \
#     -n finops-team--finops-tools-backend
#
apiVersion: v1
kind: Secret
metadata:
  name: finops-api-snowflake
  namespace: finops-team--finops-tools-backend
type: Opaque
stringData:
  SNOWFLAKE_ACCOUNT: example-account
  SNOWFLAKE_USER: example-user
  SNOWFLAKE_WAREHOUSE: EXAMPLE_WH
  SNOWFLAKE_ROLE: EXAMPLE_ROLE
  SNOWFLAKE_DATABASE: EXAMPLE_DB
  SNOWFLAKE_SCHEMA: EXAMPLE_SCHEMA
